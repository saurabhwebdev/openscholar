# OpenScholar env — copy to .env and fill in real secrets (never commit them).
# NOTE: docker-compose.yml runs the APP ONLY; there is no Postgres service.
# The app connects to the existing host database (school at 127.0.0.1:5432,
# reachable as host.docker.internal from inside containers).

# Host Postgres (compose default swaps 127.0.0.1 -> host.docker.internal).
DATABASE_URL=postgresql://admin1:dev-local-only@127.0.0.1:5432/school
# Address the app listens on (0.0.0.0:<port> inside containers).
BIND_ADDR=0.0.0.0:8081
# Seeded on first boot only (placeholder — use a real secret locally).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-admin-123
ADMIN_NAME=Administrator
# Log filter.
RUST_LOG=opencodetest=info,tower_http=info,sqlx=warn
# Outbound email (local relay e.g. Mailpit on 1025; no TLS, no auth by default).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=school@example.com
# REST API bearer token (default dev-api-token).
API_TOKEN=dev-api-token
