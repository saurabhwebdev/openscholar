# OpenScholar env — copy to .env and fill in real secrets (never commit them).
# NOTE: docker-compose.yml runs the APP ONLY; there is no Postgres service.
# The app connects to the existing host database (school at 127.0.0.1:5432,
# reachable as host.docker.internal from inside containers).

# Host Postgres (compose default swaps 127.0.0.1 -> host.docker.internal).
DATABASE_URL=postgresql://admin1:dev-local-only@127.0.0.1:5432/school
# Address the app listens on (0.0.0.0:<port> inside containers).
BIND_ADDR=0.0.0.0:8081

# REQUIRED IN PRODUCTION — the app warns loudly at boot if these are defaults.
# Initial admin, seeded on first boot only. Use a strong, unique password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-admin-123
ADMIN_NAME=Administrator

# Session cookie Secure flag. MUST stay true in production (HTTPS). Set to
# false ONLY for local plain-HTTP development.
COOKIE_SECURE=true

# Timezone: run the app in the SCHOOL'S timezone so dates (enrolment,
# attendance "today") are correct. Set the container/host TZ (IANA name).
TZ=UTC

# Log filter.
RUST_LOG=opencodetest=info,tower_http=info,sqlx=warn

# Outbound email. Remote relays use STARTTLS automatically; localhost is
# treated as a plaintext dev relay (e.g. Mailpit on 1025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=school@example.com

# REST API bearer token. REQUIRED to enable /api/* bearer access — the bearer
# path is DISABLED unless this is set to a strong, non-default value.
# Leaving it unset or at "dev-api-token" disables programmatic API access.
API_TOKEN=
